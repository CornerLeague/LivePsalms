VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# === PostHog product analytics (sub-project: client-side telemetry) ===
#
# VITE_PUBLIC_POSTHOG_KEY is the project API key (starts with phc_). It is a
# client-side key designed to be exposed in the browser bundle — not a secret.
# Find it in PostHog → Project Settings → "Project API Key".
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === Lamplight Reasoning Layer (sub-project 3) ===
#
# ANTHROPIC_API_KEY is server-side only. The Edge Function reads it via
# Deno.env. Set it via:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Do NOT put it in .env.local — the browser must never see this key.
#
# VOYAGE_AI_KEY is ALSO server-side only (embed-note / lamplight-generate read
# it via Deno.env). Set it as a secret, never in .env.local:
#   supabase secrets set VOYAGE_AI_KEY=...
#
# ALLOWED_ORIGINS locks the Edge Functions' CORS allow-list (comma-separated).
# Unset → localhost dev fallback. In production set your real origin(s):
#   supabase secrets set ALLOWED_ORIGINS=https://yourdomain.com
#
# RERANK_ENABLED toggles Voyage rerank-2.5 inside searchBible /
# searchNeighbors. Defaults to off (pgvector cosine ordering is final).
# To enable on the Edge Function:
#   supabase secrets set RERANK_ENABLED=true
